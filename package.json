{
  "name": "bevox-meta-api",
  "version": "0.1.0",
  "description": "Multi-tenant HTTP gateway over Meta's WhatsApp Cloud API and Instagram Graph API: encrypted token custody, onboarding (OAuth, Embedded Signup, Coexistence), outbound queues and HMAC-signed webhook fan-out.",
  "license": "FSL-1.1-MIT",
  "author": "Bernard Tavares",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx/esm src/index.ts",
    "worker:out": "tsx src/workers/outbound-dispatcher.ts",
    "worker:in": "tsx src/workers/webhook-delivery.ts",
    "worker:tok": "tsx src/workers/token-refresh.ts",
    "worker:cleanup": "tsx src/workers/cleanup.ts",
    "worker:media": "tsx src/workers/media-download.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"db/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"db/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "seed": "tsx scripts/seed.ts",
    "cli": "tsx scripts/admin-cli/index.ts",
    "openapi:types": "openapi-typescript docs/architecture/openapi.yaml -o src/types/api.ts",
    "openapi:check": "openapi-typescript docs/architecture/openapi.yaml --output -",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@google-cloud/kms": "^5.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.50.0",
    "bullmq": "5",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5",
    "fastify-plugin": "^5.1.0",
    "fastify-sse-v2": "^4.2.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "pino": "9",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "undici": "^8.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "5",
    "vitest": "4"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(k8s/**)",
      "Edit(.taskmaster/**)",
      "Edit(.claude/**)",
      "Edit(package.json)",
      "Edit(tsconfig*.json)",
      "Edit(eslint.config.js)",
      "Edit(vitest*.config.ts)",
      "Edit(drizzle.config.ts)",
      "Edit(docker-compose.yml)",
      "Edit(Dockerfile)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(k8s/**)",
      "Write(.taskmaster/**)",
      "Write(.claude/**)",
      "Read(../bevox-knowledge/**)",
      "Read(../bevox-PRD-consolidation/**)",
      "Read(../agency-agents/**)",
      "Read(../bevox-meta-api-smoke/**)",
      "Edit(../bevox-meta-api-smoke/**)",
      "Write(../bevox-meta-api-smoke/**)",
      "Bash(pnpm:*)",
      "Bash(task-master:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(docker compose:*)",
      "Bash(tsx:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Edit(prds/**)",
      "Write(prds/**)",
      "Edit(docs/adr/MA-001*.md)",
      "Edit(docs/adr/MA-002*.md)",
      "Edit(docs/adr/MA-003*.md)",
      "Edit(docs/adr/MA-004*.md)",
      "Edit(docs/adr/MA-005*.md)",
      "Edit(docs/adr/MA-006*.md)",
      "Edit(docs/adr/MA-007*.md)",
      "Edit(docs/adr/MA-008*.md)",
      "Edit(db/migrations/**)",
      "Write(db/migrations/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/SessionStart.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreToolUse-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-openapi.sh",
            "if": "Edit(docs/architecture/openapi.yaml)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-adr.sh",
            "if": "Edit(docs/adr/MA-*.md)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-contracts.sh",
            "if": "Edit(docs/architecture/openapi.yaml)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-contracts.sh",
            "if": "Edit(src/mcp/**)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-modules.sh",
            "if": "Edit(src/modules/**)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-secrets-scan.sh",
            "if": "Edit(src/**/*.ts)"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-openapi.sh",
            "if": "Write(docs/architecture/openapi.yaml)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-adr.sh",
            "if": "Write(docs/adr/MA-*.md)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-contracts.sh",
            "if": "Write(docs/architecture/openapi.yaml)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-contracts.sh",
            "if": "Write(src/mcp/**)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-modules.sh",
            "if": "Write(src/modules/**)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/PostToolUse-secrets-scan.sh",
            "if": "Write(src/**/*.ts)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreCompact.sh"
          }
        ]
      }
    ]
  }
}

# bevox-meta-api — variáveis de ambiente
#
# Copie para .env (NUNCA commitar) e ajuste valores antes de subir o serviço.
# Referências: PRD §11/§12/§13, ADRs MA-002 (JWT), MA-007 (observabilidade),
# MA-008 (envelope encryption).

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# PostgreSQL (dedicado ao meta-api — NÃO compartilhar com Bevox V1)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://bevox:bevox_dev_password@localhost:5432/bevox_meta_api

# ----------------------------------------------------------------------------
# Redis (dedicado — BullMQ + cache de tokens decifrados em memória curta)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# KMS — envelope encryption de tokens Meta (MA-008)
# Em dev local: provider=local usa chave em arquivo (NUNCA usar em prod).
# Em prod: provider=aws|gcp com KMS_KEY_ID apontando para CMK.
# ----------------------------------------------------------------------------
KMS_PROVIDER=local
KMS_KEY_ID=local-dev-key
# Em prod com GCP: KMS_PROVIDER=gcp e KMS_KEY_ID = resource path do keyRing,
# ex.: projects/<PROJECT>/locations/<LOCATION>/keyRings/<RING>
# As 3 cryptoKeys (waba-tokens, ig-tokens, webhook-secrets) são derivadas por convenção.
# Auth: GOOGLE_APPLICATION_CREDENTIALS=/caminho/sa-key.json (SA com cloudkms.cryptoKeyEncrypterDecrypter).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mínimo: 32 bytes (256 bits) em base64. Obrigatório quando KMS_PROVIDER=local.
KMS_LOCAL_MASTER_KEY=

# ----------------------------------------------------------------------------
# Meta — credenciais do Bevox como App Meta (Embedded Signup)
# Obter em https://developers.facebook.com/apps/<app_id>/
# ----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
# Usado para validar HMAC-SHA256 dos webhooks Meta (X-Hub-Signature-256).
META_WEBHOOK_APP_SECRET=
# Base URL pública onde a Meta envia callbacks OAuth (precisa casar com a
# Valid OAuth Redirect URI configurada no Meta App). Sem trailing slash.
OAUTH_CALLBACK_BASE_URL=https://meta-api.example.com
# Embedded Signup: config_id de Facebook Login for Business (opcional).
# Se setado, /connect/init devolve este valor pro front rodar FB.login.
META_ES_CONFIG_ID=

# ----------------------------------------------------------------------------
# JWT — autenticação de consumer apps (RS256, MA-002)
# JWT_PUBLIC_KEYS_JSON é JSON com map kid -> PEM público; meta-api só valida.
# Em dev: gere par RSA com `openssl genpkey -algorithm RSA -out priv.pem ...`.
# ----------------------------------------------------------------------------
JWT_ISSUER=bevox-meta-api
JWT_AUDIENCE=bevox-meta-api
JWT_MAX_AGE_SECONDS=300
JWT_PUBLIC_KEYS_JSON=

# ----------------------------------------------------------------------------
# Admin — autenticação de endpoints /v1/admin (gestão de ConsumerApps)
# ----------------------------------------------------------------------------
ADMIN_API_KEY=local-dev-admin-key-change-me

# ----------------------------------------------------------------------------
# Webhook delivery — assinatura HMAC dos webhooks que meta-api envia
# para apps consumidores (MA-005 modo push).
# ----------------------------------------------------------------------------
WEBHOOK_DELIVERY_SIGNING_SECRET=
WEBHOOK_DELIVERY_MAX_RETRIES=8

# ----------------------------------------------------------------------------
# Observabilidade (MA-007) — todos opcionais em dev
# ----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bevox-meta-api
# A17: porta HTTP onde cada worker tsx expõe /metrics + /healthz. 0 desativa
# (testes). Em prod (k8s) o ServiceMonitor `bevox-meta-api-workers` scrapeia.
WORKER_METRICS_PORT=9090

# ----------------------------------------------------------------------------
# Storage de mídia S3-compatible (MinIO em V1; ADR-012). Privado do meta-api.
# Key = {tenant_id}/{media_id}; URLs pré-assinadas TTL curto, NUNCA logadas.
# Em prod: endpoint deve usar https:// (TLS) e os 4 primeiros são obrigatórios.
# ----------------------------------------------------------------------------
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_BUCKET=bevox-media
MEDIA_S3_REGION=us-east-1
# Tamanho máximo de mídia em bytes (default 26214400 = 25 MiB).
MEDIA_MAX_BYTES=26214400
# TTL (segundos) das URLs pré-assinadas (default 180 = 3 min).
MEDIA_PRESIGN_TTL_SECONDS=180
